PORT=3000
NODE_ENV=development
SCHOOL_NAME=우리 학교
# 실제 운영 전에 학교 도메인으로 변경 (하위 도메인은 자동 허용하지 않음)
SCHOOL_EMAIL_DOMAIN=example.ac.kr
DEPARTMENTS=컴퓨터공학과,소프트웨어학과,경영학과,디자인학과,전자공학과
BASE_URL=http://localhost:3000
# console 모드는 로컬 시연용: 인증 링크를 서버 터미널에 출력
# 운영: MAIL_MODE=smtp 와 아래 SMTP 설정 필수
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

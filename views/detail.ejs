<a href="/" class="back">← 모집 공고</a><section class="page-heading"><div><span class="eyebrow"><%= post.contest %></span><h1><%= post.title %></h1><p class="muted"><%= post.owner_name %> · 지원 마감 <%= post.deadline %> (한국 시간)</p></div><span class="badge"><%= post.deadline<today?'기간 마감':post.quotas.every(q=>q.filled>=q.capacity)?'모집 완료':'모집 중' %></span></section>
<div class="detail-grid"><section><article class="panel"><h2>이런 팀원을 기다려요</h2><p class="pre-wrap"><%= post.description %></p></article>
<% if(own){ %><section class="panel spaced"><div class="section-line"><h2>도착한 지원서</h2><span class="count"><%= applications.length %></span></div><% if(!applications.length){ %><p class="muted">아직 지원서가 없습니다.</p><% } %><% for(const a of applications){ %><article class="application"><div class="section-line"><h3><%= a.name %> <small><%= a.department %></small></h3><span class="badge <%= a.status==='approved'?'':'neutral' %>"><%= labels[a.status] %></span></div><p class="muted"><%= a.email %></p><h4>지원 동기</h4><p class="pre-wrap"><%= a.motivation %></p><h4>보유 기술 및 경험</h4><p class="pre-wrap"><%= a.skills %></p><% if(a.status==='pending'){ %><form method="post" action="/applications/<%= a.id %>/decision" class="actions"><input type="hidden" name="_csrf" value="<%= csrf %>"><button name="status" value="approved" class="button">승인</button><button name="status" value="rejected" class="button secondary">거절</button></form><% } %></article><% } %></section>
<% } else if(application){ %><section class="panel spaced"><h2>내 지원서 <span class="badge"><%= labels[application.status] %></span></h2><h3>지원 동기</h3><p class="pre-wrap"><%= application.motivation %></p><h3>보유 기술 및 경험</h3><p class="pre-wrap"><%= application.skills %></p></section>
<% } else { const q=post.quotas.find(q=>q.department===user.department); if(post.deadline>=today && q && q.filled<q.capacity){ %><section class="panel spaced"><h2>이 팀에 지원하기</h2><p class="muted"><%= user.name %> · <%= user.department %></p><form method="post" action="/posts/<%= post.id %>/apply" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>자기소개 및 지원 동기<textarea name="motivation" rows="5" minlength="10" maxlength="2000" required></textarea></label><label>보유 기술 및 경험<textarea name="skills" rows="4" minlength="2" maxlength="2000" required></textarea></label><p class="hint">지원서와 학교 이메일은 공고 작성자에게만 공개됩니다.</p><button class="button">지원서 제출</button></form></section><% } else { %><section class="panel spaced"><h2>현재 지원할 수 없는 공고예요</h2><p class="muted">모집 기간이 지났거나 소속 학과의 모집 자리가 없습니다.</p></section><% }} %></section>
<aside class="panel quota-aside"><span class="eyebrow">TEAM STATUS</span><h2>학과별 모집 현황</h2><div class="quota-list"><% for(const q of post.quotas){ %><div class="quota"><div><span><%= q.department %></span><strong><%= q.filled %> / <%= q.capacity %>명</strong></div><progress value="<%= q.filled %>" max="<%= q.capacity %>" aria-label="<%= q.department %> 모집 현황"></progress></div><% } %></div><p class="hint">승인된 지원자만 반영됩니다.<br>게시자는 모집 인원에 포함되지 않습니다.</p></aside></div>

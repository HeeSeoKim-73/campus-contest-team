<section class="page-heading"><div><span class="eyebrow">MY ACTIVITY</span><h1>내 활동</h1><p class="muted">모집 중인 팀과 내가 지원한 공고를 확인하세요.</p></div><a class="button" href="/posts/new">＋ 공고 작성</a></section><div class="two-cols"><section class="panel"><h2>내가 작성한 공고</h2><% if(!posts.length){ %><p class="muted">아직 작성한 공고가 없습니다.</p><% } %><% for(const p of posts){ %><a class="activity-row" href="/posts/<%= p.id %>"><strong><%= p.title %></strong><span class="muted">마감 <%= p.deadline %> · 지원자 관리 ↗</span></a><% } %></section><section class="panel"><h2>내 지원 현황</h2><% if(!applications.length){ %><p class="muted">아직 지원한 공고가 없습니다.</p><% } %><% for(const a of applications){ %><a class="activity-row" href="/posts/<%= a.post_id %>"><strong><%= a.title %></strong><span class="badge <%= a.status==='approved'?'':'neutral' %>"><%= labels[a.status] %></span></a><% } %></section></div>
